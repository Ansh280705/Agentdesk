# ============================================
# AgentDesk Environment Configuration
# ============================================
# Copy this file to apps/api/.env and fill in your values.
# NEVER commit the actual .env file to version control.

# --- Groq AI ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
# Recommended free model: llama-3.3-70b-versatile (supports tool calling)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Neon PostgreSQL ---
# Create a free project at: https://neon.tech
# Copy the connection string from your project dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Upstash Redis (optional) ---
# Create a free database at: https://upstash.com
# Copy REST URL and token from your database dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App Security ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars

# --- App URLs ---
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# --- Server ---
PORT=3001
NODE_ENV=development
